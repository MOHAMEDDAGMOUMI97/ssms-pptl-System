\ProvidesPackage{ssms_style}
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\color{ssmsBlue}}
  {\chaptername\ \thechapter}
  {20pt}
  {\Huge}
  [\vspace{-0.5cm}\rule{\textwidth}{2pt}]

\newcommand{\requirement}[3]{%
  \textbf{#1} & #2 & #3 \\ \hline
}

\newtcolorbox{ssmsNote}[1]{
  colback=white,
  colframe=ssmsBlue,
  arc=0pt,
  leftrule=3mm,
  title=#1,
  fonttitle=\bfseries\color{white},
  coltitle=white,
  colbacktitle=ssmsBlue
}

\newcommand{\vcyclephase}[1]{%
  \begin{center}
    \begin{tcolorbox}[colback=ssmsBlue!10, colframe=ssmsBlue, arc=0pt, boxrule=1pt]
      \textbf{V-Cycle Phase:} #1
    \end{tcolorbox}
  \end{center}
}
